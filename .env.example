# Copy this file to .env and fill in the values. .env is git-ignored.

# --- Database (required) -------------------------------------------------
DB_PASSWORD=your_postgres_password
# DB_HOST=localhost
# DB_NAME=practice
# DB_USER=postgres
# DB_PORT=5432
#
# Or one connection string, as hosted databases give you. When set it wins
# over the DB_* settings above. Leave it unset for local development.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Google sign-in (required for the web app) ---------------------------
# console.cloud.google.com -> APIs & Services
#   1. OAuth consent screen -> External -> add your own email as a Test user
#   2. Credentials -> Create credentials -> OAuth client ID -> Web application
#   3. Authorized redirect URI, exactly:
#        http://127.0.0.1:5000/auth/callback
#      (127.0.0.1, not localhost — Google treats them as different origins)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Terminal interface --------------------------------------------------
# The CLI cannot run a browser redirect, so it reads the account from here.
# Use the email you signed into the web app with.
PORTFOLIO_USER=
# Email is not unique — two accounts can share an address, for instance when
# a workspace address is reassigned to someone new. If that happens the CLI
# refuses to guess; name the account by id here instead. Wins over
# PORTFOLIO_USER when both are set. Leave blank otherwise.
PORTFOLIO_USER_ID=

# --- AI assistant (optional) ----------------------------------------------
# Create a key at aistudio.google.com/apikey. Without one the assistant panel
# still appears but explains how to set it up instead of answering.
#
# Web research (Google Search) needs billing enabled on the key's Google Cloud
# project; on a free key the assistant answers from the app's data only and
# says so. On a free key Google may also use questions to improve its
# products and people may read them.
GEMINI_API_KEY=
# ASSISTANT_ENABLED=1
# ASSISTANT_MODEL=gemini-3.8-flash
# ASSISTANT_THINKING=medium
# ASSISTANT_SEARCH=1

# --- Session signing key (required in production) -------------------------
# Signs session cookies and CSRF tokens. The app refuses to start without it
# unless it is running in debug mode (flask run --debug), where a throwaway
# key is generated. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=

# --- Hosting behind an HTTPS proxy (production only) ----------------------
# Trusts the proxy's X-Forwarded-* headers so links and the Google callback
# use https://, and marks the session cookie Secure. Never set it locally.
# BEHIND_HTTPS_PROXY=1

# --- Optional ------------------------------------------------------------
# Market data time limits (seconds) and how long a quote is reused.
# MARKET_QUOTE_TIMEOUT=8
# MARKET_HISTORY_TIMEOUT=20
# QUOTE_CACHE_SECONDS=30

# Cash each new account starts with.
# STARTING_CASH=50000

# Local sign-in form that accepts any email and verifies nothing. For trying
# the app before Google is configured. Leave unset otherwise.
# ALLOW_DEV_LOGIN=1

# --- Market data (Alpaca) --------------------------------------------------
# Prices come from Alpaca. Create a free account at alpaca.markets — a paper
# trading account is enough — then Home > API Keys > Generate. Both values
# are shown once; the secret cannot be retrieved later, only regenerated.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# The free plan serves the IEX feed. "sip" is the consolidated tape across
# every US exchange and needs a paid plan; asking for it without one is
# refused with a 403 rather than quietly downgraded. Leave blank for iex.
ALPACA_DATA_FEED=
